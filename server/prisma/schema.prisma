generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  publishedAt   DateTime?
  isbn          String?   @unique
  pageCount     Int?
  coverImageUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  author   Author @relation(fields: [authorId], references: [id])
  authorId Int

  categories Category[]
}

model Author {
  id   Int    @id @default(autoincrement())
  name String

  // Relation
  books Book[]
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  // Relation
  books Book[]
}
